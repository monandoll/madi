{
  "name": "madi",
  "private": true,
  "version": "0.1.0",
  "description": "운동·재활 크리에이터를 위한 AI 영상 편집 도구",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @madi/engine --filter @madi/web dev",
    "dev:web": "pnpm --filter @madi/web dev",
    "dev:engine": "pnpm --filter @madi/engine dev",
    "build": "pnpm --filter @madi/web build && pnpm --filter @madi/engine build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @madi/engine db:migrate",
    "db:studio": "pnpm --filter @madi/engine db:studio"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
